{
  "name": "arbora",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4327",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4327",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:local:setup": "tsx scripts/setup-local-db.ts",
    "db:local:start": "podman start arbora-postgres",
    "db:local:stop": "podman stop arbora-postgres",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.15",
    "@hookform/resolvers": "^7.0.1",
    "@xyflow/react": "^12.12.0",
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "drizzle-orm": "^0.45.4",
    "elkjs": "^0.12.1",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "pg": "^8.16.3",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
